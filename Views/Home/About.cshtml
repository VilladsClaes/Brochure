
@{
    ViewBag.Title = "Om";
}


        <section class="home-slider owl-carousel">
            <div class="slider-item" style="background-image: url('/Content/images/bg_3.jpg');" data-stellar-background-ratio="0.5">
                <div class="overlay"></div>
                <div class="container" data-scrollax-parent="true">
                    <div class="row slider-text align-items-end">
                        <div class="col-md-7 col-sm-12 ftco-animate mb-5">
                            <p class="breadcrumbs" data-scrollax=" properties: { translateY: '70%', opacity: 1.6}"><span class="mr-2"><a href="index.html">Home</a></span> <span>Trainer</span></p>
                            @* Sidetitel *@
                            <h1 class="mb-3" data-scrollax=" properties: { translateY: '70%', opacity: .9}">Om Eventur</h1>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="ftco-section about-section">
            @* Video *@
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-md-9 text-center">
                        <div class="ftco-animate">
                            @* Videooverskrift *@
                            <h2><strong>Yoga</strong> far away, behind the word mountains, far from the countries Vokalia and Consonantia, there live the blind texts. Separated they live in.</h2>
                        </div>
                        <div class="play-video d-flex justify-content-center mt-5 ftco-animate">
                            @* Videoanker *@
                            <a href="https://vimeo.com/45830194" class="icon popup-vimeo d-flex align-items-center justify-content-center">
                                <span class="icon-play"></span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

@* PERSONALE VIS MEDVÆRTER *@
        <section class="ftco-section bg-light">
            <div class="container">
                @* Overskrift for personale *@
                <div class="row justify-content-center mb-5 pb-5 ftco-animate">
                    <div class="col-md-7 text-center heading-section">
                        <h2>Meet our trainers, bitch</h2>
                    </div>
                </div>
                <div class="row">

                    @* Løkke af personale *@
                    <div class="col-md-4 ftco-animate">
                        <div class="trainer">
                            <a href="#" class="trainer-img mb-4" style="background-image: url(/Content/images/trainer_1.jpg);"></a>
                            <div class="text text-center">
                                <h3 class="mb-3">Alice Smith <br><span class="position">Yoga Expert</span></h3>
                                <p>A small river named Duden flows by their place and supplies it with the necessary regelialia.</p>
                                <div class="button-degree button-degree-dark-bg">
                                    <span><a href="#" class="btn px-4 py-3">View class times</a></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 ftco-animate">
                        <div class="trainer">
                            <a href="#" class="trainer-img mb-4" style="background-image: url(/Content/images/trainer_2.jpg);"></a>
                            <div class="text text-center">
                                <h3 class="mb-3">John Bulk <br><span class="position">Body Expert</span></h3>
                                <p>A small river named Duden flows by their place and supplies it with the necessary regelialia.</p>
                                <div class="button-degree button-degree-dark-bg">
                                    <span><a href="#" class="btn px-4 py-3">View class times</a></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 ftco-animate">
                        <div class="trainer">
                            <a href="#" class="trainer-img mb-4" style="background-image: url(/Content/images/trainer_3.jpg);"></a>
                            <div class="text text-center">
                                <h3 class="mb-3">Madonna Henderson <br><span class="position">Health Expert</span></h3>
                                <p>A small river named Duden flows by their place and supplies it with the necessary regelialia.</p>
                                <div class="button-degree button-degree-dark-bg">
                                    <span><a href="#" class="btn px-4 py-3">View class times</a></span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </section>

        <section class="ftco-section">
            <div class="container">
                @* Tilbud overskrift *@
                <div class="row justify-content-center mb-5 pb-5 ftco-animate">
                    <div class="col-md-7 text-center heading-section">
                        <h2>All in one Yoga classes</h2>
                    </div>
                </div>
                <div class="row">
                    @* Løkke med tilbud *@
                    @* udskift kun anker og h3 *@
                    <div class="col-md-4 ftco-animate" data-scrollax-parent="true">
                        <div class="classes" data-scrollax=" properties: { translateY: '-70%'}">
                            <a href="#" class="classes-img mb-3" style="background-image: url(/Content/images/classes-1.jpg);"></a>
                            <div class="text text-center">
                                <h3><a href="#">Yoga Program</a></h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 ftco-animate">
                        <div class="classes">
                            <a href="#" class="classes-img mb-3" style="background-image: url(/Content/images/classes-3.jpg);"></a>
                            <div class="text text-center">
                                <h3><a href="#">Cardio Program</a></h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 ftco-animate" data-scrollax-parent="true">
                        <div class="classes" data-scrollax=" properties: { translateY: '-100%'}">
                            <a href="#" class="classes-img mb-3" style="background-image: url(/Content/images/classes-3.jpg);"></a>
                            <div class="text text-center">
                                <h3><a href="#">Body Building</a></h3>
                            </div>
                        </div>
                    </div>

                </div>
                @* Gå til tilbudsside-overskrift *@
                <div class="row mt-5 ftco-animate">
                    <div class="col-md-12 text-center button-degree button-degree-outline-primary">
                        <p><a href="#" class="btn px-5 py-4">Explore our classes</a></p>
                    </div>
                </div>
            </div>
        </section>
