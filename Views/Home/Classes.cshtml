                            <a href="#" class="classes-img mb-3" style="background-image: url(/Content/images/classes-1.jpg);"></a>
                            <div class="text text-center">
                                <h3><a href="#">Yoga Program</a></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 ftco-animate">
