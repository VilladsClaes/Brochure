
@{
    ViewBag.Title = "Timetable";
}


        <section class="home-slider owl-carousel">
            <div class="slider-item" style="background-image: url('/Content/images/bg_3.jpg');" data-stellar-background-ratio="0.5">
                <div class="overlay"></div>
                <div class="container" data-scrollax-parent="true">
                    <div class="row slider-text align-items-end">
                        <div class="col-md-7 col-sm-12 ftco-animate mb-5">
                            <p class="breadcrumbs" data-scrollax=" properties: { translateY: '70%', opacity: 1.6}"><span class="mr-2"><a href="index.html">Home</a></span> <span>timetable</span></p>
                            @* Sidetitel *@
                            <h1 class="mb-3" data-scrollax=" properties: { translateY: '70%', opacity: .9}">Class Schedule</h1>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <section class="ftco-section">
            @* Løkke med Begivenheder *@
            <div class="container">
                <div class="row justify-content-center mb-5 pb-5">
                    <div class="col-md-7 text-center heading-section ftco-animate">
                        @* Begivenheder overskrift *@
                        <h2>Classes Schedule</h2>
                    </div>
                </div>
                <div class="row">

                    <div class="col-md-12 mb-5">

